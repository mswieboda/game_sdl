# Set default behavior to handle line endings automatically.
* text=auto eol=lf

# Explicitly set LF for Crystal and configuration files
*.cr text eol=lf
*.yml text eol=lf
*.lock text eol=lf
Makefile text eol=lf
*.md text eol=lf

# Denotate binary files
*.png binary
*.wav binary
*.ttf binary
*.ogg binary
*.mp3 binary
*.bmp binary
*.jpg binary
*.jpeg binary
*.obj binary
*.o binary
*.json text eol=lf

# Treat third-party C library code as vendored (excludes it from language stats and search)
src/ext/stb_truetype.h linguist-vendored
src/ext/stb_truetype.c linguist-vendored
